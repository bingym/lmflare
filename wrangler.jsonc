{
  "name": "lmflare",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lmflare-db",
      "database_id": "1e9cf340-3857-47a6-89a6-93c82b74523e",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "2d00396089e24aecbaf631f13dcf5634"
    }
  ],
  "vars": {}
}
